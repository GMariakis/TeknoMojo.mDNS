{
  "mDNS": {
    "network": {
      "hostName": "",
      "networkInterfaces": ["*"],
      "useIPv6": false,
      "timeToLive": 255
    },
    "services": [
      {
        "name": "My Web Server",
        "type": "_http._tcp",
        "port": 8080,
        "protocol": "http",
        "enabled": true,
        "properties": {
          "version": "1.0",
          "path": "/api",
          "description": "REST API Server"
        }
      },
      {
        "name": "File Transfer Service",
        "type": "_ftp._tcp",
        "port": 2121,
        "protocol": "tcp",
        "enabled": true,
        "properties": {
          "secure": "false",
          "maxConnections": "10"
        }
      },
      {
        "name": "Custom UDP Service",
        "type": "_myapp._udp",
        "port": 5000,
        "protocol": "udp",
        "enabled": true,
        "properties": {
          "appVersion": "2.1.0",
          "features": "feature1,feature2"
        }
      },
      {
        "name": "MessagePack Service",
        "type": "_msgpack._tcp",
        "port": 9000,
        "protocol": "messagepack",
        "enabled": true,
        "properties": {
          "version": "1.0.0",
          "format": "MessagePack 3.1.4",
          "encoding": "binary",
          "endpoints": "status,health"
        }
      },
      {
        "name": "SignalR Notification Hub",
        "type": "_signalr._tcp",
        "port": 5001,
        "protocol": "signalr",
        "enabled": true,
        "properties": {
          "version": "1.0.0",
          "hubPath": "/notification",
          "features": "messaging,groups,private-messages",
          "transport": "WebSockets"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "mDNS": "Debug"
    }
  }
}
